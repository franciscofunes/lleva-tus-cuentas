// LTC — categorías personales (Firebase Spark compatible).
//
// Pegar SOLO este match dentro de:
// service cloud.firestore { match /databases/{database}/documents { ... } }
//
// NO reemplazar el ruleset existente (cardStatements, litaChats,
// notifications, portfolioPositions, subscribers, etc.).
// extraFieldIds es una lista opcional e INMUTABLE de claves permitidas.
// Además de estas reglas, actualizar la validación del match de expenses
// según firestore.rules.customTransactionDetails antes de desplegar UI.
// La colección compartida /categories conserva su regla existente:
//   allow read: if request.auth != null;
//   allow create, update, delete: if false;
//
// Antes de desplegar LTC publicar estas reglas en Firebase Console.
// No requiere Firebase Storage, Cloud Functions, App Check ni plan Blaze.

match /users/{uid}/customCategories/{categoryId} {
  function ownsCustomCategories() {
    return request.auth != null && request.auth.uid == uid;
  }

  // Optional for backwards compatibility with categories created before this feature.
  // Only LTC-defined metadata can be configured. At most three fields per category.
  function validExtraFieldSelection(data) {
    return !('extraFieldIds' in data) ||
      (data.extraFieldIds is list
       && data.extraFieldIds.size() <= 3
       && data.extraFieldIds.hasOnly([
         'reference', 'counterparty', 'paymentMethod', 'receiptNumber', 'operationDate',
         'dueDate', 'serviceAccount', 'billingPeriod'
       ]));
  }

  function validPersonalCategory() {
    let d = request.resource.data;
    return d.keys().hasAll(['name', 'isExpense', 'active', 'createdAt', 'updatedAt'])
      && d.keys().hasOnly(['name', 'isExpense', 'active', 'createdAt', 'updatedAt', 'extraFieldIds'])
      && categoryId.matches('^[a-z0-9-]{3,80}$')
      && d.name is string
      && d.name.size() >= 2
      && d.name.size() <= 50
      && d.name.matches('^[^\\r\\n]+$')
      && d.isExpense is bool
      && d.active is bool
      && validExtraFieldSelection(d)
      && d.createdAt is timestamp
      && d.updatedAt is timestamp;
  }

  allow get, list: if ownsCustomCategories();

  allow create: if ownsCustomCategories()
    && validPersonalCategory()
    && request.resource.data.active == true
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  // Never rename or change type: historical transactions depend on them.
  // Soft archive and reactivate are the ONLY permitted updates.
  allow update: if ownsCustomCategories()
    && validPersonalCategory()
    && request.resource.data.diff(resource.data).affectedKeys()
       .hasOnly(['active', 'updatedAt'])
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.name == resource.data.name
    && request.resource.data.isExpense == resource.data.isExpense
    && request.resource.data.get('extraFieldIds', []) == resource.data.get('extraFieldIds', [])
    && request.resource.data.updatedAt == request.time;

  // Deleting would orphan old transaction categories; archive instead.
  allow delete: if false;
}
