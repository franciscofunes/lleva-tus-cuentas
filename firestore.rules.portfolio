// Portfolio rules fragment.
// IMPORTANT: merge this into the Firebase project's existing firestore.rules.
// Do not deploy this file as a replacement without reviewing the project's current rules.
//
// Recommended document paths:
// users/{uid}/portfolioPositions/{positionId}
// users/{uid}/portfolioSnapshots/{snapshotId}
//
// Keeping financial data below /users/{uid} makes ownership explicit and
// lets the rule depend on the authenticated path rather than a client-supplied owner field.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserPath(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/portfolioPositions/{positionId} {
      allow read, create, update, delete: if ownsUserPath(uid);
    }

    match /users/{uid}/portfolioSnapshots/{snapshotId} {
      allow read, create, update, delete: if ownsUserPath(uid);
    }

    // Historial de conversaciones de LITA. El iframe nunca recibe el UID;
    // el host LTC persiste los chats usando la sesión Firebase ya autenticada.
    match /users/{uid}/litaChats/{chatId} {
      allow read, create, update, delete: if ownsUserPath(uid);
    }
  }
}
