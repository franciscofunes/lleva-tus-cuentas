// Merge this block into the deployed Firestore ruleset under
// match /databases/{database}/documents.
// It is not a complete replacement for existing LTC rules.
//
// NOTE: Firestore security rules cannot authenticate LITA server responses;
// clients may only write to THEIR OWN uid, and every saved item is detail-only.
// The LITA API cryptographically verifies Firebase ID tokens before analysis.

match /users/{uid}/cardStatements/{statementId} {
  function owner() {
    return request.auth != null && request.auth.uid == uid;
  }
  function validStatement() {
    let d = request.resource.data;
    return d.keys().hasOnly([
      'schema', 'expenseId', 'fileSha256', 'institution', 'cardBrand',
      'period', 'closingDate', 'dueDate', 'totals', 'purchases',
      'minimumPaymentArs', 'taxesArs', 'previousCreditArs', 'itemCount',
      'countedInCashFlow', 'approvedByUser', 'updatedAt'
    ])
    && d.schema == 'ltc.card-statement.v1'
    && d.fileSha256 == statementId
    && statementId.matches('^[0-9a-f]{64}$')
    && d.expenseId is string
    && d.expenseId.size() <= 128
    && d.countedInCashFlow == false
    && d.approvedByUser == true
    && d.institution is string && d.institution.size() <= 70
    && d.cardBrand is string && d.cardBrand.size() <= 30
    && d.period is string && d.period.matches('^20[0-9]{2}-[0-9]{2}$')
    && d.closingDate is string && d.dueDate is string
    && d.totals.keys().hasAll(['ARS', 'USD'])
    && d.totals.ARS is string && d.totals.USD is string
    && d.purchases.keys().hasAll(['ARS', 'USD'])
    && d.purchases.ARS is string && d.purchases.USD is string
    && d.itemCount is int && d.itemCount > 0 && d.itemCount <= 400
    && d.updatedAt is timestamp
    && exists(/databases/$(database)/documents/users/$(uid)/expenses/$(d.expenseId))
    && get(/databases/$(database)/documents/users/$(uid)/expenses/$(d.expenseId)).data.category.matches('.*Resumen tarjeta.*');
  }
  allow get, list: if owner();
  allow create: if owner() && validStatement();
  allow update: if owner() && validStatement()
    && request.resource.data.expenseId == resource.data.expenseId
    && request.resource.data.fileSha256 == resource.data.fileSha256;
  allow delete: if owner();

  match /items/{itemId} {
    function owner() {
      return request.auth != null && request.auth.uid == uid;
    }
    function validItem() {
      let i = request.resource.data;
      return i.keys().hasOnly([
        'date', 'merchant', 'amount', 'currency', 'category',
        'receipt', 'installment', 'sourcePage', 'type',
        'includeInAnalytics', 'countedInCashFlow'
      ])
      && i.date is string && i.date.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
      && i.merchant is string && i.merchant.size() <= 90
      && i.amount is string && i.amount.matches('^[0-9]+[.][0-9]{2}$')
      && i.currency in ['ARS', 'USD']
      && i.category is string && i.category.size() <= 80
      && i.receipt is string && i.receipt.size() <= 12
      && (i.installment == null || (i.installment is string && i.installment.size() <= 24))
      && (i.sourcePage == null || (i.sourcePage is int && i.sourcePage >= 1 && i.sourcePage <= 12))
      && i.type == 'purchase'
      && i.includeInAnalytics is bool
      && i.countedInCashFlow == false;
    }
    allow get, list: if owner();
    allow create, update: if owner() && validItem()
      && itemId.matches('^[0-9]{4}$')
      && existsAfter(/databases/$(database)/documents/users/$(uid)/cardStatements/$(statementId));
    allow delete: if owner();
  }
}
